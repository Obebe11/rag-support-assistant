# Copy to .env and adjust. Never commit .env.
# Every value below is safe for local use; the file contains no secrets.

# --- Application ---
APP_ENV=development

# PostgreSQL with pgvector, asyncpg driver.
# Leave empty for `make dev`: it starts an embedded PostgreSQL in .local/postgres.
# Docker Compose sets its own value.
DATABASE_URL=

# Ports for local development.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Bearer token for /api/admin. Admin endpoints reject every request while it is empty.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# Comma-separated origins allowed to call the API from a browser.
# Not needed when the frontend proxies /api (the default in dev and Compose).
CORS_ALLOWED_ORIGINS=

# --- LLM: local | openai_compatible ---
# local works offline and is labeled as a demo mode; it is not a working LLM.
LLM_PROVIDER=local
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Prices in US dollars per one million tokens. Only `make eval` uses them, to report the
# API cost of an evaluation run. Leave empty and the report says the cost is not configured.
LLM_INPUT_PRICE_PER_MILLION_TOKENS=
LLM_OUTPUT_PRICE_PER_MILLION_TOKENS=

# --- Embeddings: local | openai_compatible ---
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# --- CRM: simulated | hubspot ---
# simulated sends nothing outside this system and is labeled as a demo mode.
# hubspot needs HUBSPOT_ACCESS_TOKEN; see docs/inquiries.md for the token type and scopes.
CRM_PROVIDER=simulated
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
# Date-based HubSpot API version used in request paths.
HUBSPOT_API_VERSION=2026-09
HUBSPOT_TIMEOUT_SECONDS=10
# Check CRM credentials and required fields at startup; /api/health reports the result.
CRM_ACCESS_CHECK_ENABLED=true
CRM_ACCESS_CHECK_INTERVAL_SECONDS=300
# Automatic delivery attempts per inquiry. A manual retry starts a new set.
DELIVERY_MAX_ATTEMPTS=5

# --- Uploads and background jobs ---
MAX_UPLOAD_BYTES=10485760
WORKER_POLL_INTERVAL_SECONDS=1
JOB_BACKOFF_BASE_SECONDS=5
JOB_BACKOFF_MAX_SECONDS=300
JOB_TIMEOUT_SECONDS=120
JOB_LEASE_SECONDS=300

# --- Docker Compose only ---
POSTGRES_USER=handoff
POSTGRES_PASSWORD=handoff
POSTGRES_DB=handoff
